APP_NAME="Sulnet Prospecta"
APP_ENV=development
APP_PUBLIC_URL=http://localhost:8000
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Chaves separadas. Em produção use valores distintos, aleatórios e com 32+ caracteres.
SESSION_SIGNING_KEY=
DATA_ENCRYPTION_KEY=
# Somente durante rotação de dados antigos; remova após concluir.
LEGACY_DATA_ENCRYPTION_KEY=
TRUSTED_HOSTS=localhost,127.0.0.1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
SESSION_MAX_AGE_SECONDS=43200
# Redis: sessão server-side, rate-limit distribuído e locks/cache futuros.
REDIS_URL=
# MFA pode ser obrigatório por papel, ex.: ADMIN,GESTOR,SUPERVISOR
MFA_REQUIRED_ROLES=
# OIDC corporativo opcional (Microsoft Entra ID / Google Workspace / outro provider OIDC)
OIDC_METADATA_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=
DATABASE_URL=sqlite:///./data/sulnet_prospecta.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=15
DATABASE_POOL_RECYCLE_SECONDS=1800
SESSION_COOKIE=sulnet_prospecta_session
DEFAULT_TIMEZONE=America/Sao_Paulo

BOOTSTRAP_ADMIN_NAME="Administrador Sulnet"
BOOTSTRAP_ADMIN_EMAIL=admin@sulnet.local
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha

APIFY_TOKEN=
APIFY_ACTOR_ID=nwua9Gu5YrADL7ZDj

ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_WEBHOOK_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_URL_STYLE=virtual-host
MEDIA_MAX_UPLOAD_MB=50
# Opcional: hosts permitidos para arquivar mídia remota, separados por vírgula.
# Ex.: *.z-api.io,files.z-api.io
MEDIA_REMOTE_ALLOWED_HOSTS=
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
# Backup criptografado do PostgreSQL (serviço/cron separado)
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_URL_STYLE=virtual-host

WHATSAPP_PRESENCE_TIMEOUT_SECONDS=90

OPENAI_API_KEY=
AI_SDR_ENABLED=true
AI_AUTONOMOUS_ENABLED=false
AI_SDR_POLL_SECONDS=3
# Somente uma instância do worker deve executar Supervisor/Learning/Engineer.
AI_MAINTENANCE_ENABLED=true

# Supervisor IA — Fase A / modo sombra.
# Observa SDR, Vendedor IA e follow-ups, mas não interfere no atendimento.
AI_SUPERVISOR_SHADOW_ENABLED=true
AI_SUPERVISOR_MODEL=gpt-6-luna
AI_SUPERVISOR_REASONING_EFFORT=low
AI_SUPERVISOR_POLL_SECONDS=4

# Supervisor IA — Fase B / Guardião em tempo real.
# Quando true, valida e pode reescrever/bloquear a saída antes do WhatsApp.
# Começa false para permitir deploy e ativação controlada.
AI_SUPERVISOR_GUARDIAN_ENABLED=false
AI_SUPERVISOR_GUARDIAN_TIMEOUT_SECONDS=30

# Fase C — autocorreção operacional segura.
AI_AUTOCORRECT_ENABLED=false
AI_AUTOCORRECT_POLL_SECONDS=30

# Fase D — aprendizado por experimentos A/B de copy.
# Não altera preço, plano, contrato, crédito, estado ou handoff.
AI_LEARNING_ENABLED=false
AI_LEARNING_POLL_SECONDS=300
AI_LEARNING_MIN_SAMPLES_PER_ARM=30
AI_LEARNING_MIN_UPLIFT=0.05

# Fase E — Engineer IA.
# Diagnóstico/propostas pode ser ativado sem credencial GitHub.
AI_ENGINEER_ENABLED=false
AI_ENGINEER_POLL_SECONDS=300
AI_ENGINEER_MIN_INCIDENTS=3
# Abertura autônoma de PR permanece desligada até existir credencial dedicada.
AI_ENGINEER_AUTONOMOUS_PR_ENABLED=false
AI_ENGINEER_GITHUB_REPOSITORY=rafaelsantos-coder/Sistema-Prospeccao
AI_ENGINEER_GITHUB_TOKEN=


# Vendedor IA de fechamento
AI_SELLER_ENABLED=false
# URL do CRM Sulnet, sem barra final.
SULNET_CRM_BASE_URL=
# Chave oficial servidor-a-servidor do CRM. É enviada em X-Integration-Key.
SULNET_AI_INTEGRATION_KEY=
# Compatibilidade temporária com versões antigas do CRM que ainda exigem Bearer.
# Pode permanecer configurada durante a migração; o Prospecta prefere X-Integration-Key.
SULNET_CRM_BEARER_TOKEN=
